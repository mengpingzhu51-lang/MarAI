# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# LangGraph.js Agent (OpenAI-compatible LLM backend)
# ---------------------------------------------------------------------------
# LANGGRAPH_LLM_API_KEY: API key for the LLM backend (required to enable AI).
# LANGGRAPH_LLM_BASE_URL: Optional base URL for OpenAI-compatible endpoints
#   (e.g. Azure OpenAI, DeepSeek, vLLM, OpenRouter, Together, Groq, self-hosted).
#   Leave empty to use the default OpenAI endpoint.
# LANGGRAPH_LLM_MODEL: Model name (defaults to gpt-4o-mini).
# LANGGRAPH_LLM_TEMPERATURE: Sampling temperature (defaults to 0.2).
# LANGGRAPH_LLM_MAX_TOKENS: Max output tokens per response (defaults to 2048).
LANGGRAPH_LLM_API_KEY=
LANGGRAPH_LLM_BASE_URL=
LANGGRAPH_LLM_MODEL=gpt-4o-mini
LANGGRAPH_LLM_TEMPERATURE=0.2
LANGGRAPH_LLM_MAX_TOKENS=2048

# Google Single Sign-On (OAuth 2.0 Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Supabase Configuration
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL: Your Supabase project URL (required, exposes to browser).
# NEXT_PUBLIC_SUPABASE_ANON_KEY: The anonymous key (required, exposes to browser).
# SUPABASE_ANON_KEY: Same anon key, used server-side.
# SUPABASE_SERVICE_ROLE_KEY: Service role key (server-side only, bypasses RLS — keep secret!).
# SUPABASE_JWT_SECRET: JWT secret for verifying tokens server-side.
# SUPABASE_PUBLISHABLE_KEY: Supabase publishable key for platform API.
# SUPABASE_SECRET_KEY: Supabase secret key for platform API (server-side only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Supabase / PostgreSQL Database Connection Strings
# ---------------------------------------------------------------------------
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
